{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-trust-benchmark.example/schemas/authority-relation-vector-0.1.json",
  "title": "Candidate Authority Relation Interoperability Vector v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "vector_id", "title", "description", "observed", "expected"],
  "properties": {
    "schema": {"const": "atb-authority-relation-vector/0.1"},
    "vector_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "observed": {"$ref": "#/$defs/observed"},
    "expected": {"$ref": "#/$defs/output"}
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "action", "target"],
      "properties": {
        "resource": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1}
      }
    },
    "authorityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source", "subject", "kind", "action", "independently_issued"],
      "properties": {
        "status": {"enum": ["VALID", "MISSING", "INVALID"]},
        "source": {"type": ["string", "null"]},
        "subject": {"type": ["string", "null"]},
        "kind": {"enum": ["REQUEST", "EXECUTION"]},
        "action": {"$ref": "#/$defs/action"},
        "independently_issued": {"type": "boolean"}
      }
    },
    "delegationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "authority_source", "delegator", "delegatee", "action", "attenuated"],
      "properties": {
        "status": {"enum": ["VALID", "MISSING", "INVALID"]},
        "authority_source": {"type": ["string", "null"]},
        "delegator": {"type": ["string", "null"]},
        "delegatee": {"type": ["string", "null"]},
        "action": {"$ref": "#/$defs/action"},
        "attenuated": {"type": "boolean"}
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requester", "actor", "requested_action", "claimed_relation", "request_authority", "execution_authority", "delegation"],
      "properties": {
        "requester": {"type": "string", "minLength": 1},
        "actor": {"type": "string", "minLength": 1},
        "requested_action": {"$ref": "#/$defs/action"},
        "claimed_relation": {"enum": ["DELEGATED", "INDEPENDENT", "NONE"]},
        "request_authority": {"$ref": "#/$defs/authorityEvidence"},
        "execution_authority": {"$ref": "#/$defs/authorityEvidence"},
        "delegation": {"$ref": "#/$defs/delegationEvidence"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "status", "vector_id", "requester", "actor", "request_authority_source", "request_authority_valid", "execution_authority_source", "immediate_authority_grantor", "execution_authority_valid", "authority_relation", "authorized", "reason"],
      "properties": {
        "schema": {"const": "atb-authority-relation-output/0.1"},
        "status": {"enum": ["DECIDED", "UNSUPPORTED"]},
        "vector_id": {"type": "string", "minLength": 1},
        "requester": {"type": "string", "minLength": 1},
        "actor": {"type": "string", "minLength": 1},
        "request_authority_source": {"type": ["string", "null"]},
        "request_authority_valid": {"type": "boolean"},
        "execution_authority_source": {"type": ["string", "null"]},
        "immediate_authority_grantor": {"type": ["string", "null"]},
        "execution_authority_valid": {"type": "boolean"},
        "authority_relation": {"enum": ["DELEGATED", "INDEPENDENT", "NONE", "INVALID"]},
        "authorized": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
