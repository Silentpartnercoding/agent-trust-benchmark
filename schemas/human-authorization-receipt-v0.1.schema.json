{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-trust-benchmark.invalid/schemas/human-authorization-receipt-v0.1.json",
  "title": "Human Authorization Receipt payload v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "issuer",
    "human",
    "agent",
    "authorization",
    "audience",
    "authorization_event",
    "revocation",
    "issued_at",
    "not_before",
    "expires_at",
    "nonce"
  ],
  "properties": {
    "schema_version": {"const": "har/0.1"},
    "receipt_id": {"type": "string", "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"},
    "issuer": {"type": "string", "minLength": 1},
    "human": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1}
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cnf"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "cnf": {
          "type": "object",
          "additionalProperties": false,
          "required": ["jkt"],
          "properties": {
            "jkt": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopes", "actions"],
      "properties": {
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resource", "action"],
            "properties": {
              "resource": {"type": "string", "minLength": 1},
              "action": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "authorization_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "mode", "authenticated_at", "witnessed_at", "acr", "amr"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["interactive_consent", "administrator_configured"]},
        "authenticated_at": {"type": "string", "format": "date-time"},
        "witnessed_at": {"type": "string", "format": "date-time"},
        "acr": {"type": "string", "minLength": 1},
        "amr": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "handle"],
      "properties": {
        "authority": {"type": "string", "minLength": 1},
        "handle": {"type": "string", "minLength": 1}
      }
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "not_before": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "nonce": {"type": "string", "minLength": 16}
  }
}
