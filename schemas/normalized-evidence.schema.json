{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-trust-benchmark.invalid/schemas/normalized-evidence-v0.1.json",
  "title": "Agent Trust Benchmark normalized evidence event v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "experiment_id",
    "run_id",
    "event_type",
    "observed_at",
    "evidence_origin",
    "raw_evidence_ref"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "provider": {"type": "string", "minLength": 1},
    "experiment_id": {"const": "e001"},
    "run_id": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "minLength": 1},
    "human_id": {"type": ["string", "null"]},
    "agent_id": {"type": ["string", "null"]},
    "credential_id": {"type": ["string", "null"]},
    "delegation_id": {"type": ["string", "null"]},
    "requested_scopes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "granted_scopes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "resource": {"type": ["string", "null"]},
    "action": {"type": ["string", "null"]},
    "decision": {"enum": ["allow", "deny", "observe", "unknown"]},
    "effect_count": {"type": "integer", "minimum": 0},
    "observed_at": {"type": "string", "format": "date-time"},
    "provider_event_id": {"type": ["string", "null"]},
    "correlation_id": {"type": ["string", "null"]},
    "evidence_origin": {"enum": ["provider_native", "enforcement_point", "benchmark_observation"]},
    "raw_evidence_ref": {"type": "string", "minLength": 1}
  }
}
