{
  "realm": "atb",
  "enabled": true,
  "displayName": "Agent Trust Benchmark",
  "sslRequired": "NONE",
  "accessTokenLifespan": 300,
  "eventsEnabled": true,
  "eventsExpiration": 3600,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "roles": {
    "realm": [
      {"name": "payments_preview", "description": "May preview a payment"},
      {"name": "payments_execute", "description": "May execute a payment"}
    ]
  },
  "clientScopes": [
    {
      "name": "payments:preview",
      "description": "Allow the agent to preview payments",
      "protocol": "openid-connect",
      "attributes": {
        "display.on.consent.screen": "true",
        "consent.screen.text": "Preview payments",
        "include.in.token.scope": "true"
      }
    }
  ],
  "users": [
    {
      "username": "human-e001",
      "enabled": true,
      "email": "human-e001@example.invalid",
      "emailVerified": true,
      "firstName": "E001",
      "lastName": "Human",
      "requiredActions": [],
      "credentials": [
        {"type": "password", "value": "local-human-password", "temporary": false}
      ],
      "realmRoles": ["payments_preview"]
    }
  ],
  "clients": [
    {
      "clientId": "agent-e001",
      "name": "E001 Agent",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-agent-client-secret",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "consentRequired": true,
      "redirectUris": ["http://127.0.0.1:18999/callback"],
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "basic", "email"],
      "optionalClientScopes": ["payments:preview"],
      "fullScopeAllowed": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "agent-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "agent-e001",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "delegation-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "delegation_id",
            "claim.value": "keycloak-delegation-e001",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ]
}
